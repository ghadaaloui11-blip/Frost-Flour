# Copy this file to ".env" and change the values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# Local MongoDB (installed or Docker):
MONGODB_URI=mongodb://127.0.0.1:27017/frost_flour
# MongoDB Atlas (cloud) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/frost_flour

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# URL of the React app (for CORS)
CLIENT_URL=http://localhost:5173

# First Agent account created by "npm run seed"
SEED_AGENT_EMAIL=agent@frostflour.tn
SEED_AGENT_PASSWORD=agent123

# Payment (provider still to choose)
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=change-me
